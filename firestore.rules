rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function admin(){return signedIn() && me().status=="admin";}
  match /users/{uid}{
   allow read:if signedIn()&&(request.auth.uid==uid||admin());
   allow create:if signedIn()&&request.auth.uid==uid;
   allow update:if admin() || (signedIn()&&request.auth.uid==uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName"]));
  }
  match /items/{id}{allow read:if true;allow write:if admin();}
  match /listings/{id}{allow read:if true;allow create:if signedIn()&&request.resource.data.sellerId==request.auth.uid;allow update,delete:if admin()||(signedIn()&&resource.data.sellerId==request.auth.uid);}
  match /transactions/{id}{allow read:if admin()||(signedIn()&&(resource.data.buyerId==request.auth.uid||resource.data.sellerId==request.auth.uid||resource.data.userId==request.auth.uid));allow write:if admin();}
  match /fxTransactions/{id}{allow read:if admin()||(signedIn()&&resource.data.userId==request.auth.uid);allow write:if admin();}
  match /fcCodes/{code}{allow read:if signedIn();allow write:if admin();}
  match /reports/{id}{allow create:if signedIn()&&request.resource.data.reporterId==request.auth.uid;allow read,update,delete:if admin();}
  match /bank/{id}{allow read:if signedIn();allow write:if admin();}
 }}
